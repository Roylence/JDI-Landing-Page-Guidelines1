{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "guidelines": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "team-policy"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        },
        "headingFamilyTokens": {
          "type": "object",
          "properties": {
            "1": {
              "type": "string"
            },
            "2": {
              "type": "string"
            },
            "3": {
              "type": "string"
            },
            "4": {
              "type": "string"
            },
            "5": {
              "type": "string"
            },
            "6": {
              "type": "string"
            }
          },
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ],
          "additionalProperties": false
        },
        "categoryAliases": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "appliesTo": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "all",
                    "zero",
                    "code"
                  ]
                }
              },
              "requirements": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tokenRefs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "appliesTo",
              "requirements"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "source",
        "headingFamilyTokens",
        "categoryAliases",
        "rules"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "mode": {
          "type": "string",
          "const": "zero-snapshot"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "designId",
        "url",
        "exportedAt",
        "mode",
        "notes"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "color",
              "dimension",
              "number",
              "string",
              "boolean"
            ]
          },
          "$value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "additionalProperties": false
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "zero",
              "implementation-policy"
            ]
          },
          "sourceId": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "px",
              "%",
              "em"
            ]
          }
        },
        "required": [
          "$type",
          "$value",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "textStyles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tokenRefs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "tokenRefs"
        ],
        "additionalProperties": false
      }
    },
    "paintStyles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tokenRefs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "tokenRefs"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "module",
              "component",
              "template"
            ]
          },
          "sourceNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "styleKey": {
            "type": "string",
            "minLength": 1
          },
          "contentPresets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceAssetId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "sourceNodeIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "propertyOverrides": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "boolean"
                    ]
                  }
                },
                "nestedInstanceOverrides": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string"
                      },
                      "assetId": {
                        "type": "string"
                      },
                      "propertyOverrides": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": [
                            "string",
                            "boolean"
                          ]
                        }
                      }
                    },
                    "required": [
                      "nodeId",
                      "assetId",
                      "propertyOverrides"
                    ],
                    "additionalProperties": false
                  }
                },
                "cardCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sourceAssetId",
                "name",
                "sourceNodeIds",
                "propertyOverrides"
              ],
              "additionalProperties": false
            }
          },
          "nativeBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                }
              },
              "required": [
                "nodeId",
                "field",
                "token"
              ],
              "additionalProperties": false
            }
          },
          "component": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "COMPONENT"
              },
              "key": {
                "type": "string"
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "TEXT",
                        "BOOLEAN",
                        "INSTANCE_SWAP",
                        "VARIANT",
                        "SLOT"
                      ]
                    },
                    "defaultValue": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "VARIABLE_ALIAS"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type",
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "variantOptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "preferredValues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "key": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "key"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "defaultValue"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "nodeId",
              "type",
              "properties"
            ],
            "additionalProperties": false
          },
          "structure": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "tags",
          "kind",
          "sourceNodeIds",
          "structure"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "tokens",
    "assets"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "componentInstance": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1
            },
            "componentNodeId": {
              "type": "string"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "assetId",
            "componentNodeId",
            "properties"
          ],
          "additionalProperties": false
        },
        "nativeLayout": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "NONE",
                "HORIZONTAL",
                "VERTICAL",
                "GRID"
              ]
            },
            "wrap": {
              "type": "string",
              "enum": [
                "NO_WRAP",
                "WRAP"
              ]
            },
            "widthSizing": {
              "type": "string",
              "enum": [
                "FIXED",
                "HUG",
                "FILL"
              ]
            },
            "heightSizing": {
              "type": "string",
              "enum": [
                "FIXED",
                "HUG",
                "FILL"
              ]
            },
            "positioning": {
              "type": "string",
              "enum": [
                "AUTO",
                "ABSOLUTE"
              ]
            },
            "primaryAlign": {
              "type": "string",
              "enum": [
                "MIN",
                "MAX",
                "CENTER",
                "SPACE_BETWEEN"
              ]
            },
            "counterAlign": {
              "type": "string",
              "enum": [
                "MIN",
                "MAX",
                "CENTER",
                "BASELINE"
              ]
            }
          },
          "required": [
            "mode",
            "wrap",
            "widthSizing",
            "heightSizing",
            "positioning",
            "primaryAlign",
            "counterAlign"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "headingLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "textAlign": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right",
            "justified"
          ]
        },
        "componentPropertyReferences": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokenRefs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "textRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string"
              },
              "tokenRefs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "nativeBindings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "textStyleId": {
                "type": "string",
                "minLength": 1
              },
              "fillStyleId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "end",
              "text",
              "tokenRefs",
              "nativeBindings"
            ],
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "display": {
              "type": "string",
              "enum": [
                "stack",
                "grid",
                "flex"
              ]
            },
            "columnsToken": {
              "type": "string"
            },
            "mobileColumnsToken": {
              "type": "string"
            },
            "gapToken": {
              "type": "string"
            },
            "maxWidthToken": {
              "type": "string"
            }
          },
          "required": [
            "display"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "role",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "title": "JDI design asset snapshot"
}
